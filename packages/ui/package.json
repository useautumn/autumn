{
	"name": "@useautumn/ui",
	"version": "0.1.0",
	"type": "module",
	"description": "Autumn's React design system: Base UI components and Tailwind v4 tokens",
	"author": "Autumn",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/useautumn/autumn.git",
		"directory": "packages/ui"
	},
	"homepage": "https://useautumn.com",
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"sideEffects": [
		"*.css"
	],
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./ai-elements": {
			"types": "./dist/components/ai-elements/index.d.ts",
			"import": "./dist/components/ai-elements/index.js"
		},
		"./table": {
			"types": "./dist/components/table/index.d.ts",
			"import": "./dist/components/table/index.js"
		},
		"./styles.css": "./src/styles/index.css",
		"./*": {
			"types": "./dist/*.d.ts",
			"import": "./dist/*.js"
		}
	},
	"files": [
		"dist",
		"src/styles"
	],
	"scripts": {
		"build": "bun scripts/build.ts",
		"ts": "tsc --noEmit"
	},
	"dependencies": {
		"@base-ui/react": "^1.4.1",
		"@phosphor-icons/react": "^2.1.10",
		"@squircle/tailwindcss": "^1.0.6",
		"@tanstack/react-table": "^8.21.3",
		"@tanstack/react-virtual": "^3.13.18",
		"@xyflow/react": "^12.11.0",
		"ai": "^6.0.5",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"date-fns": "^3.6.0",
		"embla-carousel-react": "^8.6.0",
		"input-otp": "^1.4.2",
		"lucide-react": "^0.562.0",
		"motion": "^12.26.1",
		"nanoid": "^5.1.6",
		"react-day-picker": "^8.10.1",
		"react-hotkeys-hook": "^4.6.1",
		"react-resizable-panels": "^4.11.0",
		"recharts": "3.9.2",
		"shiki": "^3.20.0",
		"streamdown": "^1.6.10",
		"tailwind-merge": "^3.0.2",
		"tailwind-scrollbar-hide": "^4.0.0",
		"tailwindcss": "^4.0.13",
		"tailwindcss-animate": "^1.0.7",
		"tokenlens": "^1.3.1",
		"use-stick-to-bottom": "^1.1.1"
	},
	"peerDependencies": {
		"react": "^19.0.0",
		"react-dom": "^19.0.0"
	},
	"devDependencies": {
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"@typescript/native-preview": "catalog:",
		"typescript": "~5.7.2"
	}
}
