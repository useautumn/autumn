+Baton KafkaConsumer::WithFatalCause(Baton error) {
+  if (error.err() != RdKafka::ERR__FATAL) return error;
+  // librdkafka queues ERR__FATAL alone and keeps the cause (an authorization refusal, a fenced instance)
+  // on the handle; an application deciding whether to come back needs the cause.
+  std::string errstr;
+  RdKafka::ErrorCode fatal = RdKafka::ERR_NO_ERROR;
+  {
+    scoped_shared_read_lock lock(m_connection_lock);
+    if (IsConnected()) fatal = m_client->fatal_error(errstr);
+  }
+  if (fatal == RdKafka::ERR_NO_ERROR)
+    return Baton(RdKafka::ERR__FATAL, RdKafka::err2str(RdKafka::ERR__FATAL),
+                 true, false, false);
+  // The binding's JS error keeps only the text after the first ": ", so the message is the code's own.
+  return Baton(fatal, RdKafka::err2str(fatal), true, false, false);
+}
