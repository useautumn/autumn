+void KafkaConsumer::DeferConsumeError(RdKafka::ErrorCode code) {
+  int none = RdKafka::ERR_NO_ERROR;
+  // The first error wins: a fatal error is never overwritten by what followed it.
+  m_deferred_consume_error.compare_exchange_strong(none, static_cast<int>(code));
+}
+
+RdKafka::ErrorCode KafkaConsumer::TakeDeferredConsumeError() {
+  return static_cast<RdKafka::ErrorCode>(
+      m_deferred_consume_error.exchange(RdKafka::ERR_NO_ERROR));
+}
