{
  "name": "atmn",
  "version": "2.0.0",
  "license": "MIT",
  "description": "The CLI for Autumn — define your pricing in code, sync it to Autumn, and keep everything in version control.",
  "bin": {
    "atmn": "dist/bin.js"
  },
  "main": "dist/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/useautumn/autumn.git",
    "directory": "packages/atmn"
  },
  "homepage": "https://docs.useautumn.com/api-reference/cli/getting-started",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "ts": "bunx tsgo --build --noEmit",
    "build": "bun run bun.config.ts",
    "dev": "bun scripts/watchBuild.ts",
    "test": "bun test test",
    "prepack": "bun run build"
  },
  "files": [
    "dist",
    "src",
    "package.json",
    "README.md"
  ],
  "dependencies": {
    "@ast-grep/napi": "0.45.3",
    "arctic": "3.7.0",
    "chalk": "5.6.2",
    "commander": "14.0.3",
    "dotenv": "16.6.1",
    "jiti": "2.7.0",
    "open": "10.2.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@typescript/native-preview": "catalog:"
  }
}
