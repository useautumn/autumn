{
  "name": "@useautumn/sdk",
  "version": "0.10.18",
  "author": "Speakeasy",
  "main": "./dist/commonjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "type": "module",
  "tshy": {
    "sourceDialects": [
      "@useautumn/sdk/source"
    ],
    "exports": {
      ".": "./src/index.ts",
      "./package.json": "./package.json",
      "./types": "./src/types/index.ts",
      "./models": "./src/models/index.ts",
      "./*.js": "./src/*.ts",
      "./*": "./src/*.ts"
    }
  },
  "sideEffects": false,
  "scripts": {
    "lint": "eslint --cache --max-warnings=0 src",
    "build": "tshy",
    "prepublishOnly": "npm run build",
    "test": "bun test"
  },
  "peerDependencies": {
    
  },
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "eslint": "^10.7.0",
    "globals": "^15.14.0",
    "tshy": "^3.3.2",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.65.0"
  },
  "dependencies": {
    "zod": "^3.25.65 || ^4.0.0"
  }
}
