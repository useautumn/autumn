# Localhost overlay for Cursor Cloud. Sourced AFTER Infisical so this VM
# never shares the team Neon DB, Redis/Dragonfly, or AWS SQS queue.
# Not secrets — committed on purpose.
#
# Infisical `dev` includes laptop-docker Redis on :6380 and encrypted
# Dragonfly Cloud backups. Those must not win here.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/autumn
DATABASE_CRITICAL_URL=postgresql://postgres:postgres@localhost:5432/autumn
REDIS_URL=redis://localhost:6379
MISC_CACHE_DRAGONFLY_PUBLIC_URL=redis://localhost:6379
CACHE_V2_DRAGONFLY_URL=redis://localhost:6379
CACHE_V2_DRAGONFLY_PUBLIC_URL=redis://localhost:6379
SQS_QUEUE_URL=http://localhost:9324/000000000000/autumn.fifo
SQS_QUEUE_URL_V2=http://localhost:9324/000000000000/autumn.fifo
TRACK_SQS_QUEUE_URL=http://localhost:9324/000000000000/autumn-track.fifo
TRACK_ASYNC_SQS_QUEUE_URL=http://localhost:9324/000000000000/autumn-track.fifo
TRACK_ASYNC_STANDARD_SQS_QUEUE_URL=http://localhost:9324/000000000000/autumn-track-async
STRIPE_WEBHOOK_SQS_QUEUE_URL=http://localhost:9324/000000000000/autumn-stripe-webhook.fifo
TINYBIRD_CLICKHOUSE_URL=http://localhost:8123
AUTUMN_API_URL=http://localhost:8080
AUTUMN_PUBLIC_API_URL=http://localhost:8080
CLIENT_URL=http://localhost:3000
STRIPE_WEBHOOK_SKIP_VERIFY=true
NODE_ENV=development
INFISICAL_ENVIRONMENT=dev
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=x
AWS_SECRET_ACCESS_KEY=x
