DESCRIPTION >
    Bounded history backfill from events_property_mv into daily aggregate states. Run only for
    source hours inserted before the forward materialization seam to avoid double-counting.

NODE migrate
SQL >
    %
    SELECT
        org_id,
        env,
        customer_id,
        entity_id,
        event_name,
        property_key,
        property_value,
        toStartOfDay(hour) as day,
        sumState(total_value) as total_value,
        sumState(event_count) as event_count
    FROM events_property_mv
    WHERE hour >= {{DateTime(start_date, '2026-05-01 00:00:00')}}
        AND hour < {{DateTime(end_date, '2026-05-02 00:00:00')}}
    GROUP BY org_id, env, customer_id, entity_id, event_name, property_key, property_value, day

TYPE COPY
TARGET_DATASOURCE events_property_daily_mv
COPY_MODE append
