DESCRIPTION >
    Bounded history backfill for events_org_property_coverage_hourly_mv. Use half-open chunks ending
    no later than the materializer promote time because append mode does not deduplicate the seam.

NODE migrate
SQL >
    %
    SELECT
        org_id,
        env,
        event_name,
        kv.1 as property_key,
        toStartOfHour(timestamp) as hour,
        sumState(toUInt64(1)) as event_count
    FROM events
    ARRAY JOIN JSONExtractKeysAndValues(properties::String, 'String') as kv
    WHERE timestamp >= {{DateTime(start_date, '2026-07-01 00:00:00')}}
        AND timestamp < {{DateTime(end_date, '2026-07-02 00:00:00')}}
        AND kv.2 != ''
    GROUP BY org_id, env, event_name, property_key, hour

TYPE COPY
TARGET_DATASOURCE events_org_property_coverage_hourly_mv
COPY_MODE append
