DESCRIPTION >
    Bounded history backfill for events_org_property_hourly_mv. Use half-open chunks ending no
    later than the materializer promote time because append mode does not deduplicate the seam.

NODE migrate
SQL >
    %
    SELECT
        org_id,
        env,
        event_name,
        property_key,
        property_value,
        hour,
        sumState(total_value) as total_value,
        sumState(event_count) as event_count
    FROM events_property_mv
    WHERE hour >= {{DateTime(start_date, '2026-07-01 00:00:00')}}
        AND hour < {{DateTime(end_date, '2026-07-02 00:00:00')}}
    GROUP BY org_id, env, event_name, property_key, property_value, hour

TYPE COPY
TARGET_DATASOURCE events_org_property_hourly_mv
COPY_MODE append
