DESCRIPTION >
    Row count and id XOR-hash of one events_history_export* chunk (same params and WHERE as the
    sinks), or per-key counts of a sort-key column inside it (group_by) for splitting a chunk.
    source=mv counts events_by_timestamp_mv, which the props sink reads by default.
    with_xor=1 adds the id hash; it reads the id column, so leave it off for whole-month counts.

TOKEN events_history_export_runner READ

NODE endpoint
SQL >
    %
    SELECT
        {% if defined(group_by) and group_by == 'org_id' %} org_id AS k,
        {% elif defined(group_by) and group_by == 'env' %} env AS k,
        {% elif defined(group_by) and group_by == 'customer_id' %} customer_id AS k,
        {% else %} '' AS k,
        {% end %}
        count() AS c,
        {% if defined(with_xor) and Int8(with_xor, 0) == 1 %} toString(groupBitXor(cityHash64(id))) {% else %} '' {% end %} AS x
    FROM
        {% if defined(source) and source == 'mv' %} events_by_timestamp_mv {% else %} events {% end %}
    WHERE timestamp >= toDateTime64({{ String(start_ts, '1970-01-01 00:00:00') }}, 6)
      AND timestamp < toDateTime64({{ String(end_ts, '1970-01-01 00:00:00') }}, 6)
      {% if defined(org_from) and String(org_from, '') != '' %} AND org_id >= {{ String(org_from) }} {% end %}
      {% if defined(org_to) and String(org_to, '') != '' %} AND org_id < {{ String(org_to) }} {% end %}
      {% if defined(env_from) and String(env_from, '') != '' %} AND env >= {{ String(env_from) }} {% end %}
      {% if defined(env_to) and String(env_to, '') != '' %} AND env < {{ String(env_to) }} {% end %}
      {% if defined(cust_from) and String(cust_from, '') != '' %} AND customer_id >= {{ String(cust_from) }} {% end %}
      {% if defined(cust_to) and String(cust_to, '') != '' %} AND customer_id < {{ String(cust_to) }} {% end %}
    GROUP BY k
    ORDER BY k

TYPE endpoint
