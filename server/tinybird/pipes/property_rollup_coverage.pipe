DESCRIPTION >
    Counts events where a property is present, including values collapsed by the cardinality gate.
    The server compares this with returned grouped counts before deciding to retry ungated.

TOKEN "property_rollup_coverage_read" READ

NODE endpoint
TYPE endpoint
SQL >
    %
    WITH
        toDateTime({{ String(start_date, '2024-01-01 00:00:00') }}) AS window_start,
        toDateTime({{ String(end_date, '2024-12-31 23:59:59') }}) AS window_end,
        if(window_start = toStartOfHour(window_start), toStartOfHour(window_start), addHours(toStartOfHour(window_start), 1)) AS full_hours_start,
        toStartOfHour(window_end) AS full_hours_end
    SELECT event_name, sum(event_count_value) as event_count
    FROM (
        SELECT event_name, sumMerge(event_count) as event_count_value
        FROM events_org_property_coverage_hourly_mv
        WHERE org_id = {{ String(org_id, '') }}
            AND env = {{ String(env, 'test') }}
            AND event_name IN {{ Array(event_names, 'String', default='[]') }}
            AND property_key = {{ String(property_key, '') }}
            AND hour >= full_hours_start AND hour < full_hours_end
        GROUP BY event_name

        UNION ALL

        SELECT event_name, count() as event_count_value
        FROM events
        WHERE org_id = {{ String(org_id, '') }}
            AND env = {{ String(env, 'test') }}
            AND event_name IN {{ Array(event_names, 'String', default='[]') }}
            AND {{ column('properties.' + String(property_key, '')) }}::String IS NOT NULL
            AND {{ column('properties.' + String(property_key, '')) }}::String != ''
            AND timestamp >= window_start AND timestamp <= window_end
            AND (timestamp < full_hours_start OR timestamp >= full_hours_end)
        GROUP BY event_name
    )
    GROUP BY event_name
