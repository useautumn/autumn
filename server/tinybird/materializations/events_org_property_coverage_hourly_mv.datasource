DESCRIPTION >
    Org-level hourly counts for events where each property key is present. Property values are not
    stored, so UUID and per-event-unique values cannot increase this rollup's cardinality.

SCHEMA >
    `org_id` String,
    `env` String,
    `event_name` String,
    `property_key` String,
    `hour` DateTime,
    `event_count` AggregateFunction(sum, UInt64)

ENGINE "AggregatingMergeTree"
ENGINE_PARTITION_KEY "toYYYYMM(hour)"
ENGINE_SORTING_KEY "org_id, env, property_key, event_name, hour"

BACKFILL skip
