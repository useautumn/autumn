DESCRIPTION >
    Collapses the gated hourly property rollup into mergeable UTC daily states. Reading from the
    existing rollup keeps its value-shape gate and avoids repeating JSON extraction.

NODE materialize
SQL >
    SELECT
        org_id,
        env,
        customer_id,
        entity_id,
        event_name,
        property_key,
        property_value,
        toStartOfDay(hour) as day,
        sumState(total_value) as total_value,
        sumState(event_count) as event_count
    FROM events_property_mv
    GROUP BY org_id, env, customer_id, entity_id, event_name, property_key, property_value, day

TYPE materialized
DATASOURCE events_property_daily_mv
