-    return Baton(RdKafka::ERR_NO_ERROR);
-  } else {
-    Baton result(error->code(), error->str(), error->is_fatal(),
-                 error->is_retriable(), error->txn_requires_abort());
-    delete error;
-    return result;
-  }
-}
