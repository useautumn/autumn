{
	"name": "@autumn/atom",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"main": "src/main.ts",
	"scripts": {
		"start": "bun --config=./bunfig.toml src/main.ts",
		"dev": "NODE_ENV=development ATOM_PRETTY_LOGS=true bun --watch --no-clear-screen --config=./bunfig.toml src/main.ts",
		"test": "bun test --config ./bunfig.toml tests/unit",
		"test:unit": "bun test --config ./bunfig.toml tests/unit",
		"ts": "tsc --noEmit",
		"bench:deduct": "NODE_ENV=production bun --config=./bunfig.toml tests/bench/deductBench.ts",
		"bench:replicas": "NODE_ENV=production bun --config=./bunfig.toml tests/bench/replicaBench.ts",
		"bench:hot": "NODE_ENV=production bun --config=./bunfig.toml tests/bench/hotCustomerBench.ts",
		"bench:feedback-autumn": "bun tests/bench/feedbackAutumn.ts",
		"rig:replica": "bun tests/bench/rig/rigReplica.ts",
		"rig:driver": "bun tests/bench/rig/rigDriver.ts",
		"rig:autumn": "bun tests/bench/rig/rigAutumn.ts",
		"rig:load": "bun tests/bench/rig/rigLoad.ts",
		"rig:report": "bun tests/bench/rig/rigReport.ts",
		"rig:roll": "bun tests/bench/rig/rigRoll.ts",
		"rig:rollload": "bun tests/bench/rig/rigRollLoad.ts",
		"rig:rollreport": "bun tests/bench/rig/rigRollReport.ts"
	},
	"dependencies": {
		"@alienplatform/bindings": "3.3.28",
		"@autumn/balance-engine": "workspace:*",
		"@autumn/byoc": "workspace:*",
		"@autumn/env": "workspace:*",
		"@autumn/logging": "workspace:*",
		"@autumn/shared": "workspace:*",
		"@aws-sdk/client-sqs": "^3.958.0",
		"hono": "^4.13.5",
		"zod": "^3.25.23"
	},
	"devDependencies": {
		"@types/bun": "1.4.2",
		"@types/node": "^24.9.1",
		"typescript": "~5.8.3"
	}
}
