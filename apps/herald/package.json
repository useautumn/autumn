{
	"name": "@autumn/herald",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"start": "bun --config=./bunfig.toml src/main.ts",
		"dev": "NODE_ENV=development KAFKA_AUTH_MODE=${KAFKA_AUTH_MODE:-none} bun --watch --no-clear-screen --config=./bunfig.toml src/main.ts",
		"test": "bun test --config ./bunfig.toml tests/unit",
		"test:unit": "bun test --config ./bunfig.toml tests/unit",
		"ts": "tsc --noEmit"
	},
	"dependencies": {
		"@autumn/balance-engine": "workspace:*",
		"@autumn/balance-webhooks": "workspace:*",
		"@autumn/cache": "workspace:*",
		"@autumn/edge-config": "workspace:*",
		"@autumn/encryption": "workspace:*",
		"@autumn/catalog-lru": "workspace:*",
		"@autumn/env": "workspace:*",
		"@autumn/kafka": "workspace:*",
		"@autumn/logging": "workspace:*",
		"@autumn/postgres": "workspace:*",
		"@autumn/shared": "workspace:*",
		"@autumn/tinybird": "workspace:*",
		"decimal.js": "^10.5.0",
		"@autumn/svix": "workspace:*",
		"kafkajs": "^2.2.4",
		"zod": "^3.25.23"
	},
	"devDependencies": {
		"@types/bun": "1.3.14",
		"@types/node": "^24.9.1",
		"typescript": "~5.8.3"
	}
}
