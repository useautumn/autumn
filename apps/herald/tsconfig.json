{
	"compilerOptions": {
		"paths": {
			"@api/*": ["../../shared/api/*"],
			"@models/*": ["../../shared/models/*"],
			"@utils/*": ["../../shared/utils/*"]
		},
		"esModuleInterop": true,
		"isolatedModules": true,
		"module": "Preserve",
		"moduleResolution": "bundler",
		"noEmit": true,
		"skipLibCheck": true,
		"strict": true,
		"target": "ES2022",
		"types": ["bun", "node"]
	},
	"include": ["src/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts"]
}
