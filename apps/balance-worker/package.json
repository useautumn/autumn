{
	"name": "@autumn/balance-worker",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"start": "bun --config ./bunfig.toml src/main.ts",
		"setup:local": "bun --config ./bunfig.toml scripts/setupLocalTopics.ts",
		"dev": "bun run setup:local && bun run start",
		"test": "bun test --config ./bunfig.toml tests/unit",
		"test:kafka": "bun ../../scripts/devServices/runKafkaTests.ts tests/integration/kafka",
		"test:unit": "bun test --config ./bunfig.toml tests/unit",
		"ts": "tsc --noEmit"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1017.0",
		"@autumn/balance-engine": "workspace:*",
		"@autumn/balance-worker-protocol": "workspace:*",
		"@autumn/env": "workspace:*",
		"@autumn/kafka": "workspace:*",
		"kafkajs": "^2.2.4",
		"hono": "^4.13.5",
		"zod": "^3.25.23"
	},
	"devDependencies": {
		"@types/bun": "1.3.14",
		"@types/node": "^24.9.1",
		"typescript": "~5.8.3"
	}
}
